digraph G {
  graph [fontname="DejaVu Sans" fontsize=12 rankdir=TB nodesep=0.35 ranksep=0.45 pad=0.3 splines=spline
         labelloc=t labeljust=l label=<<B>Horizon — the full pipeline (everything that was built)</B><BR/><FONT POINT-SIZE="11"><FONT COLOR="#0F6B50"><B>green = math</B></FONT> · lavender = LLM / spotlighting · rose = direct / jailbreak layer · white = code · beige = data / software</FONT>>];
  node  [fontname="DejaVu Sans" fontsize=11 shape=box style="rounded,filled" penwidth=1.4 margin="0.18,0.08"];
  edge  [fontname="DejaVu Sans" fontsize=9 color="#7A7974" arrowsize=0.7 penwidth=1.1 fontcolor="#52514E"];
  subgraph cluster_sw { label=<<B>0 · Software &amp; infrastructure</B>> style="rounded" color="#A8A6A0" fontsize=13 margin=14;
  uv [label=<<B>uv + Python 3.11</B><BR/><FONT POINT-SIZE="9">pinned uv.lock · scripts/setup.sh</FONT>> fillcolor="#F6F5F2" color="#A8A6A0" fontcolor="#1F1F1E"];
  ollama [label=<<B>Ollama → Qwen3-8B</B><BR/><FONT POINT-SIZE="9">RTX 4060 · 16k ctx · q8 KV · flash attn<BR/>P-LLM, Q-LLM, attacker</FONT>> fillcolor="#EEEDFB" color="#5B4FC9" fontcolor="#2E2780"];
  proxy [label=<<B>Role proxy</B><BR/><FONT POINT-SIZE="9">developer→system · thinking off</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  litellm [label=<<B>LiteLLM</B><BR/><FONT POINT-SIZE="9">one client · on-disk cache</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  colibri [label=<<B>colibri engine</B><BR/><FONT POINT-SIZE="9">Qwen3.6-35B-A3B (i4)<BR/>writes the report</FONT>> fillcolor="#EEEDFB" color="#5B4FC9" fontcolor="#2E2780"];
  libs [label=<<B>Math libraries</B><BR/><FONT POINT-SIZE="9">cvxpy + Clarabel (SOCP) · scipy (Beta⁻¹, linprog)<BR/>statsmodels · numpy · Z3</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  track [label=<<B>MLflow</B><BR/><FONT POINT-SIZE="9">results/mlflow.db</FONT>> fillcolor="#F6F5F2" color="#A8A6A0" fontcolor="#1F1F1E"];
  uv -> ollama -> proxy -> litellm; uv -> colibri; uv -> libs; uv -> track [style=invis];
  }
  subgraph cluster_data { label=<<B>1 · Data (data/README.md = data card)</B>> style="rounded" color="#A8A6A0" fontsize=13 margin=14;
  dind [label=<<B>Indirect injection data</B><BR/><FONT POINT-SIZE="9">BIPIA (email · table · code, 15 attack kinds)<BR/>LLMail-Inject phase 2 (3,165)</FONT>> fillcolor="#F6F5F2" color="#A8A6A0" fontcolor="#1F1F1E"];
  ddir [label=<<B>Direct / jailbreak data</B><BR/><FONT POINT-SIZE="9">HackAPrompt (601,757 · 77,936 successful)<BR/>HarmBench · JBB · deepset · Gandalf<BR/>Tensor Trust · XSTest · Alpaca (benign)</FONT>> fillcolor="#F6F5F2" color="#A8A6A0" fontcolor="#1F1F1E"];
  dcorp [label=<<B>Corpus + canaries</B><BR/><FONT POINT-SIZE="9">attacks wrapped in carrier templates<BR/>CANARY-xxxxxxxx from secrets (CSPRNG)</FONT>> fillcolor="#F6F5F2" color="#A8A6A0" fontcolor="#1F1F1E"];
  dsplit [label=<<B>Fixed splits</B><BR/><FONT POINT-SIZE="9">fit → choose τ*, π*, λ̂ · calib · report<BR/>never report on the split used to choose</FONT>> fillcolor="#F6F5F2" color="#A8A6A0" fontcolor="#1F1F1E"];
  dagent [label=<<B>AgentDojo v1.2.1</B><BR/><FONT POINT-SIZE="9">suites slack · workspace · travel<BR/>simulated tools, no real side effects</FONT>> fillcolor="#F6F5F2" color="#A8A6A0" fontcolor="#1F1F1E"];
  dind -> dcorp -> dsplit; ddir -> dsplit [style=invis];
  }
  subgraph cluster_s1 { label=<<B>2 · Stage 1 — keyed spotlighting (offline, chooses π*)</B>> style="rounded" color="#5B4FC9" fontsize=13 margin=14;
  t [label=<<B>8 transforms τ</B><BR/><FONT POINT-SIZE="9">none · delimit · ^ datamark · N<SUP>k</SUP> dynamic marker<BR/>ROT13 · shift (25) · scramble |Σ|! · Base64</FONT>> fillcolor="#EEEDFB" color="#5B4FC9" fontcolor="#2E2780"];
  key [label=<<B>Fresh key κ per prompt</B><BR/><FONT POINT-SIZE="9">keys.py → secrets</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  xprompt [label=<<B>Spotlit prompt</B><BR/><FONT POINT-SIZE="9">x<SUB>κ</SUB>(δ) = S<SUB>κ</SUB> ‖ T ‖ τ<SUB>κ</SUB>(D ⊕ δ)</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  ind [label=<<B>Attack indicator</B><BR/><FONT POINT-SIZE="9">A(δ,κ) = 1[canary appears in output]</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  util [label=<<B>Utility</B><BR/><FONT POINT-SIZE="9">U<SUB>τ</SUB> = SQuAD token-F1 on clean docs</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  forge [label=<<B>Forging bound</B><BR/><FONT POINT-SIZE="9">q / |K<SUB>τ</SUB>|   (log-space)</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  cp [label=<<B>Clopper–Pearson</B><BR/><FONT POINT-SIZE="9">p̄ = Beta<SUP>−1</SUP>(1−α; s+1, n−s)</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  dro [label=<<B>χ²-DRO</B><BR/><FONT POINT-SIZE="9">g<SUB>ρ</SUB>(p) = p + √(2ρ p(1−p))   (else 1)</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  adp [label=<<B>Adaptive attacker (PAIR)</B><BR/><FONT POINT-SIZE="9">max over δ ∈ Δ, |Δ| ≤ attack_budget → p̄<SUP>adp</SUP></FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  comb [label=<<B>Combined risk</B><BR/><FONT POINT-SIZE="9">R̄<SUB>τ</SUB>(ρ) = min{1, q/|K<SUB>τ</SUB>| + max(g<SUB>ρ</SUB>(p̄), p̄<SUP>adp</SUP>)}</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  choice [label=<<B>Choice rule</B><BR/><FONT POINT-SIZE="9">τ* = argmin R̄<SUB>τ</SUB>  s.t.  U<SUB>τ</SUB> ≥ U<SUB>none</SUB> − η</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  sion1 [label=<<B>Sion game, level 1</B><BR/><FONT POINT-SIZE="9">V<SUB>1</SUB> = min<SUB>π</SUB> max<SUB>attack</SUB> (SOCP, cvxpy/Clarabel) → π*</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  tests1 [label=<<B>Significance</B><BR/><FONT POINT-SIZE="9">McNemar (paired) · bootstrap CI</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  s1out [label=<<B>Hand-off to Stage 2</B><BR/><FONT POINT-SIZE="9">π* · |K| = min |K<SUB>τ</SUB>| · R̄<SUB>Q</SUB> = Σ π*<SUB>τ</SUB> R̄<SUB>τ</SUB><BR/>results/stage1/pi_star.json</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  t -> xprompt; key -> xprompt; xprompt -> ind; xprompt -> util; ind -> {forge cp adp}; cp -> dro;
  {forge dro adp} -> comb; comb -> {choice sion1}; util -> choice; {choice sion1} -> tests1 -> s1out;
  }
  subgraph cluster_dir { label=<<B>3 · Direct injection / jailbreak layer (off-the-shelf, no training)</B>> style="rounded" color="#BE185D" fontsize=13 margin=14;
  user [label=<<B>User prompt u</B><BR/><FONT POINT-SIZE="9">trusted channel · role owner / member / guest</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  pg [label=<<B>Input guard</B><BR/><FONT POINT-SIZE="9">LlamaFirewall + Prompt Guard 2 (86M)</FONT>> fillcolor="#FBEAF0" color="#BE185D" fontcolor="#7A0F3C"];
  role [label=<<B>Role rules</B><BR/><FONT POINT-SIZE="9">policy.yaml: what each role may call</FONT>> fillcolor="#FBEAF0" color="#BE185D" fontcolor="#7A0F3C"];
  lg [label=<<B>Output guard</B><BR/><FONT POINT-SIZE="9">Llama Guard 3 (1B) · harm categories</FONT>> fillcolor="#FBEAF0" color="#BE185D" fontcolor="#7A0F3C"];
  can [label=<<B>Canary check</B><BR/><FONT POINT-SIZE="9">secret token leaked ⇒ block</FONT>> fillcolor="#FBEAF0" color="#BE185D" fontcolor="#7A0F3C"];
  user -> pg -> role; lg -> can [style=invis];
  }
  subgraph cluster_s2 { label=<<B>4 · Stage 2 — math-hardened CaMeL (online, every request)</B>> style="rounded" color="#5B4FC9" fontsize=13 margin=14;
  pllm [label=<<B>Privileged LLM</B><BR/><FONT POINT-SIZE="9">sees ONLY u → writes a Python-like plan</FONT>> fillcolor="#EEEDFB" color="#5B4FC9" fontcolor="#2E2780"];
  interp [label=<<B>CaMeL interpreter (STRICT)</B><BR/><FONT POINT-SIZE="9">google-research/camel, vendored unmodified<BR/>tracks data + control dependencies</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  ext [label=<<B>Tool outputs</B><BR/><FONT POINT-SIZE="9">emails · files · web (untrusted)</FONT>> fillcolor="#F6F5F2" color="#A8A6A0" fontcolor="#1F1F1E"];
  qllm [label=<<B>Quarantined LLM × m</B><BR/><FONT POINT-SIZE="9">run i: own τ<SUB>i</SUB> ~ π*, own fresh κ<SUB>i</SUB> · no tools</FONT>> fillcolor="#EEEDFB" color="#5B4FC9" fontcolor="#2E2780"];
  parse [label=<<B>Typed parser</B><BR/><FONT POINT-SIZE="9">Pydantic schema · strict / loose string caps</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  vote [label=<<B>Majority vote</B><BR/><FONT POINT-SIZE="9">&gt; m/2 identical → value, else refuse</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  hoef [label=<<B>Hoeffding</B><BR/><FONT POINT-SIZE="9">P(vote fooled) ≤ exp(−2m(½ − R̄<SUB>Q</SUB>)²)</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  score [label=<<B>Agreement score</B><BR/><FONT POINT-SIZE="9">s(x) = (# agreeing runs) / m</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  leak [label=<<B>QIF leakage</B><BR/><FONT POINT-SIZE="9">Σ log<SUB>2</SUB>|S| bits ≤ leakage_cap_bits</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  lab [label=<<B>Capability labels</B><BR/><FONT POINT-SIZE="9">SYSTEM ⊑ USER ⊑ UNTRUSTED<BR/>cap(f(v<SUB>1..k</SUB>)) = ⊔ cap(v<SUB>i</SUB>)</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  pol [label=<<B>Policy table</B><BR/><FONT POINT-SIZE="9">config/policy.yaml · strict / confirm_untrusted</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  z3 [label=<<B>Noninterference (Z3)</B><BR/><FONT POINT-SIZE="9">∀ args: UNTRUSTED ⇒ ¬ALLOW  · proven at startup</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  allow [label=<<B>ALLOW</B>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  deny [label=<<B>DENY</B>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  crc [label=<<B>Conformal risk control</B><BR/><FONT POINT-SIZE="9">ask iff s(x) ≥ λ̂, else DENY<BR/>λ̂ = min λ : (n/(n+1)) R̂(λ) + 1/(n+1) ≤ α<SUB>user</SUB></FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  ask [label=<<B>Ask the user</B><BR/><FONT POINT-SIZE="9">simulated approve / you in the shell</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  tool [label=<<B>Tool call</B><BR/><FONT POINT-SIZE="9">AgentDojo environment</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  pllm -> interp; ext -> interp; interp -> qllm [label=" untrusted x"]; qllm -> parse -> vote;
  vote -> lab -> pol -> {allow deny crc}; crc -> ask; allow -> tool; ask -> tool [label=" approved"];
  vote -> hoef [style=dashed color="#0F6B50" arrowhead=none constraint=false];
  vote -> score [style=dashed color="#0F6B50" arrowhead=none constraint=false];
  parse -> leak [style=dashed color="#0F6B50" arrowhead=none constraint=false];
  pol -> z3 [style=dashed color="#0F6B50" arrowhead=none constraint=false];
  score -> crc [style=dashed color="#0F6B50"];
  {rank=same; vote; hoef; score}
  {rank=same; parse; leak}
  {rank=same; pol; z3}
  }
  subgraph cluster_risk { label=<<B>5 · End-to-end Horizon risk</B>> style="rounded" color="#0F6B50" fontsize=13 margin=14;
  loss [label=<<B>Per-attack loss</B><BR/><FONT POINT-SIZE="9">ℓ = G + a·C + h·F<BR/>G goal hit · C confirm asked · F false refusal</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  lcp [label=<<B>Loss bound</B><BR/><FONT POINT-SIZE="9">ℓ̄ = Clopper–Pearson upper on mean loss</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  lp [label=<<B>Sion game, level 2 (LP)</B><BR/><FONT POINT-SIZE="9">min<SUB>π∈Π</SUB> max<SUB>w</SUB> Σ w ℓ̄ · scipy linprog + duals → π*, w*<BR/>Π = configs with leakage ≤ cap and U ≥ U<SUB>min</SUB></FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  vh [label=<<B>Horizon value</B><BR/><FONT POINT-SIZE="9">V<SUB>H</SUB> = min{1, Σπ q/|K| + max(E[L] + √(2ρ Var L), Σπ ℓ̄<SUP>adp</SUP>)}<BR/>(variance form pending author confirmation)</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  loss -> lcp -> lp -> vh;
  }
  subgraph cluster_eval { label=<<B>6 · Evaluation (§11 runners, logged to MLflow)</B>> style="rounded" color="#A8A6A0" fontsize=13 margin=14;
  pytest [label=<<B>Unit tests (§9)</B><BR/><FONT POINT-SIZE="9">pytest · slide values only in tests/</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  smoke [label=<<B>Smoke test</B><BR/><FONT POINT-SIZE="9">does every layer fire?</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  base [label=<<B>CaMeL baseline</B><BR/><FONT POINT-SIZE="9">reference code on AgentDojo</FONT>> fillcolor="#EEEDFB" color="#5B4FC9" fontcolor="#2E2780"];
  r1 [label=<<B>stage1_runner</B><BR/><FONT POINT-SIZE="9">static · clean · adaptive · analyze</FONT>> fillcolor="#EEEDFB" color="#5B4FC9" fontcolor="#2E2780"];
  r2 [label=<<B>agentdojo_runner</B><BR/><FONT POINT-SIZE="9">ablations none · stage1 · stage2 · stage1+2 · full<BR/>calibrate λ̂ · adaptive attacks</FONT>> fillcolor="#EEEDFB" color="#5B4FC9" fontcolor="#2E2780"];
  r3 [label=<<B>jailbreak_runner</B><BR/><FONT POINT-SIZE="9">detection rate / FPR on every direct set</FONT>> fillcolor="#FBEAF0" color="#BE185D" fontcolor="#7A0F3C"];
  pyrit [label=<<B>PyRIT</B><BR/><FONT POINT-SIZE="9">PAIR · TAP · Crescendo<BR/>success if judge score ≥ threshold</FONT>> fillcolor="#FBEAF0" color="#BE185D" fontcolor="#7A0F3C"];
  garak [label=<<B>garak</B><BR/><FONT POINT-SIZE="9">probe suite via guarded_server.py (REST)</FONT>> fillcolor="#FBEAF0" color="#BE185D" fontcolor="#7A0F3C"];
  asr [label=<<B>Metrics</B><BR/><FONT POINT-SIZE="9">ASR = s/n with CP interval · utility · FPR</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  pytest -> smoke -> base -> r1 -> r2 -> r3; r3 -> {pyrit garak}; {r1 r2 r3} -> asr;
  }
  subgraph cluster_out { label=<<B>7 · Outputs &amp; how you use it</B>> style="rounded" color="#A8A6A0" fontsize=13 margin=14;
  figs [label=<<B>Figures F1–F18</B><BR/><FONT POINT-SIZE="9">matplotlib · PDF + PNG + CSV · formula box</FONT>> fillcolor="#E1F3EE" color="#0F6B50" fontcolor="#0B4A37"];
  nb [label=<<B>Horizon.ipynb</B><BR/><FONT POINT-SIZE="9">every step, executed (nbclient)</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  rep [label=<<B>report/report.pdf</B><BR/><FONT POINT-SIZE="9">colibri model analyses figures + CSVs<BR/>numbers checked → LaTeX (xelatex)</FONT>> fillcolor="#EEEDFB" color="#5B4FC9" fontcolor="#2E2780"];
  diag [label=<<B>Pipeline diagrams</B><BR/><FONT POINT-SIZE="9">Graphviz → docs/</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  sh [label=<<B>./horizon.sh</B><BR/><FONT POINT-SIZE="9">menu · Stage 1 / Stage 2 / jailbreak demos<BR/>help · glossary · session logs</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  ra [label=<<B>./run_all.sh</B><BR/><FONT POINT-SIZE="9">quick · pilot · full · --report-only</FONT>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  ra -> figs -> nb -> rep; diag -> rep; sh -> ra [style=invis];
  }
  litellm -> pllm [lhead=cluster_s2 style=dashed];
  dsplit -> t [label=" fit / report docs"]; dagent -> ext;
  s1out -> qllm [color="#5B4FC9" penwidth=2 label=" π*, |K|"]; s1out -> hoef [color="#5B4FC9" style=dashed label=" R̄Q"];
  role -> pllm; tool -> lg; can -> ans;
  ans [label=<<B>Answer to the user</B>> fillcolor="#FFFFFF" color="#A8A6A0" fontcolor="#1F1F1E"];
  {tool deny ask} -> loss [style=dashed color="#0F6B50" label=" G, C, F per attack"]; leak -> lp [style=dashed color="#0F6B50" label=" cap"];
  ddir -> r3; dsplit -> r1; dagent -> r2; vh -> asr [style=invis];
  asr -> figs; track -> rep [style=dashed]; {r1 r2 r3} -> track [style=dashed];
}
